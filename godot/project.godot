; Engine configuration file.
; Godot 4.x project configuration for Banner of the Majlis

[application]
config/name="Banner of the Majlis"
config/description="A strategic multiplayer mobile game. Compete to earn the strongest Claim in the Majlis council."
config/icon="res://assets/sprites/icon.png"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.0", "Mobile")
config/windows_native_icon="res://assets/sprites/icon.png"

[autoload]
localization="*res://scripts/localization.gd"
audio_manager="*res://scripts/audio_manager.gd"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/mode=0
window/size/always_on_top=false
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

